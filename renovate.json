{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "description": "Patch and minor updates to dev tooling are noise as separate PRs.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dev tooling"
    },
    {
      "description": "Next and React move together; a split bump breaks the build.",
      "matchPackageNames": ["next", "react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "next and react"
    },
    {
      "description": "The @tpural/* libraries are git-tag dependencies bumped deliberately, in step with a release here.",
      "matchPackageNames": ["@tpural/**"],
      "enabled": false
    }
  ]
}
